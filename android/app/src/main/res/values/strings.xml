    <string name="start_fast_polling">Start fast polling</string>
    <string name="stop_fast_polling">Stop fast polling</string>
    <string name="fast_polling_help">Android only runs scheduled background work every 15 minutes at best. Fast polling runs a foreground service, with a permanent notification, to honour the configured polling interval.</string>

    <string name="unenroll_title">Unenroll this device?</string>
    <string name="unenroll_message">The stored device token is deleted and background work stops. The device stays in the dashboard until an administrator removes it, and re-enrolling needs a new code.</string>
    <string name="unenroll_confirm">Unenroll</string>
    <string name="unenrolled">Device unenrolled</string>

    <!-- Permissions -->
    <string name="sms_permission_title">Allow sending SMS?</string>
    <string name="sms_permission_rationale">The gateway can be asked to send an SMS from this device\'s SIM. Messages are only sent when an administrator queues a SEND_SMS command, every send is logged, and the capability must also be enabled on the server. Grant this only if outbound SMS from this device is authorised by your carrier agreement, local law, and the recipients\' consent.</string>
    <string name="sms_permission_granted">SMS permission granted</string>
    <string name="sms_permission_denied">SMS permission denied. SEND_SMS commands will report a failure.</string>
    <string name="notifications_denied">Without notification permission the gateway service cannot show its status.</string>

    <!-- Foreground service -->
    <string name="notification_channel_name">Gateway status</string>
    <string name="notification_channel_description">Shows when the gateway agent is actively polling for commands.</string>
