<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is off everywhere, with two narrow development exceptions:
  10.0.2.2 (the emulator's route to the host) and localhost. A real deployment
  must serve the gateway API over HTTPS; a device API token sent over plain HTTP
  is a token handed to anyone on the network path.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
